# =============================================================================
# Rural HealthConnect — environment configuration
# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).
# Create .env with generated secrets:   ./scripts/generate-secrets.sh
# =============================================================================

# --- Database (PostgreSQL) ---------------------------------------------------
POSTGRES_PASSWORD=
# Used by docker compose to build DATABASE_URL for the backend. For running the
# backend outside Docker, set it directly, e.g.:
# DATABASE_URL=postgres://rhc:<password>@localhost:5432/rhc
DATABASE_URL=

# --- Redis --------------------------------------------------------------------
REDIS_PASSWORD=
# REDIS_URL=redis://:<password>@localhost:6379/0
REDIS_URL=

# --- Secrets ------------------------------------------------------------------
# HMAC key for session, CSRF and one-time-code hashes (>= 32 random chars).
SESSION_SECRET=
# 32 random bytes, base64. Encrypts admin TOTP seeds at the application layer.
DATA_ENCRYPTION_KEY=
# This project uses revocable server-side sessions in HttpOnly cookies instead of
# JWTs, so JWT_SECRET / REFRESH_TOKEN_SECRET are intentionally NOT used.

# --- Web ----------------------------------------------------------------------
# Comma-separated list of allowed browser origins (exact match).
CORS_ORIGIN=http://localhost:8080
# Keep true. Browsers accept Secure cookies on http://localhost, so local Docker works.
# (false is only allowed with NODE_ENV=development, e.g. testing from another device over plain http.)
COOKIE_SECURE=true
# Number of reverse proxies in front of the API (nginx in docker compose = 1).
TRUST_PROXY=1
APP_TIMEZONE=Asia/Kolkata
LOG_LEVEL=info

# --- Files --------------------------------------------------------------------
UPLOAD_DIR=/var/lib/rhc/uploads
MAX_UPLOAD_BYTES=5242880
# Optional ClamAV daemon for malware scanning of uploads (fails closed if set but unreachable).
CLAMAV_HOST=
CLAMAV_PORT=3310

# --- Teleconsultation -----------------------------------------------------------
# Base URL of a self-hosted video service (e.g. your own Jitsi Meet). Rooms use
# unguessable random names and links are only given to the two participants.
# Leave empty to use chat-only consultations.
VIDEO_BASE_URL=

# --- Messaging (SMS / email for one-time codes and generic notifications) ------
# The server POSTs JSON {to, message} / {to, subject, message} with a Bearer key.
# Messages never contain clinical details.
SMS_API_URL=
SMS_API_KEY=
EMAIL_API_URL=
EMAIL_API_KEY=
# Voice recognition uses the browser's Web Speech API; no server key is required.
VOICE_API_KEY=

# DEVELOPMENT ONLY: print one-time codes to the server console when no SMS/email
# provider is configured. Refused when NODE_ENV=production.
DEV_PRINT_OTP=false
